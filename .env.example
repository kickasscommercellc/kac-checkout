# Kopieer naar .env.local (lokaal) of zet deze waarden in Vercel > Settings > Environment Variables.
# NOOIT secrets in de code of in GitHub zetten.

# Publieke URL van deze app (voor redirects na iDEAL e.d.)
APP_BASE_URL=https://jouw-app.vercel.app

# --- Bókun ---
# Test: https://api.bokuntest.com   Live: https://api.bokun.io
BOKUN_BASE_URL=https://api.bokuntest.com
BOKUN_ACCESS_KEY=
BOKUN_SECRET_KEY=

# --- Repayd / Trust My Travel (creditcard) ---
TMT_ENVIRONMENT=test
TMT_SITE_PATH=
TMT_CHANNEL_ID=
TMT_CHANNEL_SECRET=
# Basisvaluta van het TMT-channel (bijv. USD)
TMT_CURRENCY=USD

# --- AxcessMS / OPP (iDEAL, Apple Pay, Google Pay) ---
# Test: https://eu-test.oppwa.com   Live: https://eu-prod.oppwa.com
AXCESS_BASE_URL=https://eu-test.oppwa.com
AXCESS_ENTITY_ID=
AXCESS_ACCESS_TOKEN=

# --- Intern ---
# Lange willekeurige tekst (bijv. 64 tekens) om order-tokens te ondertekenen
ORDER_SIGNING_SECRET=
# Naam/ID van de aanbieder voor deze installatie (MVP: één aanbieder)
VENDOR_ID=test-vendor
# Komma-gescheiden Bókun product-ID's die deze aanbieder mag verkopen (verplicht!)
ALLOWED_ACTIVITY_IDS=842117,842141,842146,842148,842151,842158
